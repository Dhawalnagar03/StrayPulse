# ============================================================
# StrayPulse — Environment Variables Template
# Copy this file to .env and fill in your values.
# NEVER commit your actual .env file to version control.
# ============================================================

# --- MongoDB Atlas ---
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/straypulse?retryWrites=true&w=majority
MONGODB_DB_NAME=straypulse

# --- JWT Authentication ---
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# --- Google Maps ---
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# --- OpenWeather ---
OPENWEATHER_API_KEY=your-openweather-api-key
OPENWEATHER_BASE_URL=https://api.openweathermap.org/data/2.5

# --- Backend ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- File Storage (local or cloud) ---
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10

# --- ML ---
ML_MODEL_DIR=../ml/models
ML_PREDICTION_THRESHOLD_CONFIDENCE=0.50
ML_MIN_SIGHTINGS_FOR_PREDICTION=5

# --- Geospatial ---
DEFAULT_CITY_LAT=12.9716
DEFAULT_CITY_LNG=77.5946
DEFAULT_CITY_NAME=Bangalore
GRID_CELL_SIZE_METERS=500

# --- Notifications ---
NOTIFICATION_CONFIDENCE_THRESHOLD=0.70

# --- Admin ---
ADMIN_EMAIL=admin@straypulse.org
ADMIN_PASSWORD=ChangeThisAdminPassword!
